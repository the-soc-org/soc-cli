#!/usr/bin/env bash

# GitHub CLI extension entry point for SoC CLI.
#
# This file is named 'gh-soc' so that the GitHub CLI recognises it as the
# 'gh soc' extension.  All logic is delegated to the 'soc' dispatcher which
# reads SOC_PLATFORM_CLI from system_config.sh and invokes the appropriate
# platform-specific command script (e.g. soc-gh-open).
#
# Usage (via gh extension):  gh soc <command> [args...]
# Usage (directly):          soc <command> [args...]

exec "$(dirname "${BASH_SOURCE[0]}")/soc" "$@"
